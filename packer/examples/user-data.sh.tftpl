#!/usr/bin/env bash
# First-boot configuration for the nomad-client AMI, rendered by Terraform's
# templatefile() (see usage below). The AMI ships Nomad, Docker, the
# multi-provider remote-secrets plugin, and Traefik installed but UNCONFIGURED — this script
# injects everything environment-specific and then starts the services.
#
# Terraform usage:
#
#   user_data = templatefile("${path.module}/user-data.sh.tftpl", {
#     datacenter               = "ap-southeast-2a"
#     region                   = "apse2"
#     node_pool                = "general"          # any name; pools auto-create on registration
#     node_class               = "default"
#     server_join_tag_key      = "NomadRole"
#     server_join_tag_value    = "server"
#     op_service_account_token = var.op_service_account_token  # sensitive
#     op_cache_ttl             = "5m"
#     enable_traefik           = false
#     traefik_env              = ""                  # extra TRAEFIK_* lines, e.g. with ACLs on:
#         "TRAEFIK_PROVIDERS_NOMAD_ENDPOINT_TOKEN=$${nomad_traefik_token}"
#         (mint with ansible/cluster-acl.yml; store/fetch via 1Password)
#     nomad_extra_hcl          = ""                  # appended verbatim to runtime.hcl
#   })
#
# The token typically comes from a 1Password item itself via the Terraform
# onepassword provider, or from SSM/Secrets Manager — never from source
# control.

set -euo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data) 2>&1

# ------------------------------------------------------------------ 1Password
install -d -m 0700 /etc/remote-secrets
umask 077
cat > /etc/remote-secrets/token <<'EOT'
${op_service_account_token}
EOT
cat > /etc/remote-secrets/config.env <<'EOT'
OP_SERVICE_ACCOUNT_TOKEN_FILE=/etc/remote-secrets/token
OP_CACHE_TTL=${op_cache_ttl}
EOT
umask 022

# Fail fast (visibly, in this log) if the credentials or scope are wrong.
/opt/nomad/plugins/secrets/remote-secrets check || echo "WARNING: secrets check failed — secrets will not resolve until fixed"

# ---------------------------------------------------------------------- Nomad
cat > /etc/nomad.d/runtime.hcl <<'EOT'
datacenter = "${datacenter}"
region     = "${region}"

client {
  node_pool  = "${node_pool}"
  node_class = "${node_class}"

  server_join {
    # Requires ec2:DescribeInstances on the node's instance profile and the
    # matching tag on the Nomad servers.
    retry_join = ["provider=aws tag_key=${server_join_tag_key} tag_value=${server_join_tag_value}"]
  }
}

${nomad_extra_hcl}
EOT

systemctl enable --now nomad

# -------------------------------------------------------------------- Traefik
%{ if enable_traefik }
cat > /etc/traefik/traefik.env <<'EOT'
${traefik_env}
EOT
chmod 0600 /etc/traefik/traefik.env
systemctl enable --now traefik
%{ endif }

echo "user-data: node configured (pool=${node_pool}, dc=${datacenter}, traefik=${enable_traefik})"
