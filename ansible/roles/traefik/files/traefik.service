[Unit]
Description=Traefik edge proxy
Documentation=https://doc.traefik.io/traefik/
After=network-online.target nomad.service
Wants=network-online.target

[Service]
Type=notify
# Baked static configuration, then host/instance-specific overrides
# (Nomad ACL token, ACME email, dashboard settings, ...).
EnvironmentFile=/etc/traefik/static.env
EnvironmentFile=-/etc/traefik/traefik.env
ExecStart=/usr/local/bin/traefik
Restart=on-failure
RestartSec=5

# Traefik only needs to bind low ports; keep the rest locked down.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
