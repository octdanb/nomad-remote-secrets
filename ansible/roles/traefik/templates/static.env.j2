# {{ ansible_managed }}
# Traefik static configuration (environment-variable form). Instance- or
# host-specific settings — including TRAEFIK_PROVIDERS_NOMAD_ENDPOINT_TOKEN
# when Nomad ACLs are enabled — go in /etc/traefik/traefik.env instead.
TRAEFIK_ENTRYPOINTS_WEB_ADDRESS=:80
TRAEFIK_ENTRYPOINTS_WEBSECURE_ADDRESS=:443

# Service discovery from the local Nomad agent: services tagged
# traefik.enable=true are routed automatically.
TRAEFIK_PROVIDERS_NOMAD=true
TRAEFIK_PROVIDERS_NOMAD_ENDPOINT_ADDRESS={{ traefik_nomad_endpoint }}
TRAEFIK_PROVIDERS_NOMAD_EXPOSEDBYDEFAULT=false

TRAEFIK_API_DASHBOARD=false
TRAEFIK_LOG_LEVEL={{ traefik_log_level }}
TRAEFIK_ACCESSLOG=true
