#!/usr/bin/env bash
# First boot of a Nomad client node (pool: ${node_pool}). Rendered by
# Terraform — see clients.tf. Secrets are pulled from SSM by the instance
# itself so they never appear in user data or Terraform state.
set -euo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data) 2>&1

# ------------------------------------------------------------------ 1Password
umask 077
install -d -m 0700 /etc/nomad-secret
aws ssm get-parameter --with-decryption --region "${aws_region}" \
  --name "${op_token_ssm_parameter}" \
  --query Parameter.Value --output text > /etc/nomad-secret/token
cat > /etc/nomad-secret/config.env <<'EOT'
OP_SERVICE_ACCOUNT_TOKEN_FILE=/etc/nomad-secret/token
EOT
umask 022

/opt/nomad/plugins/secrets/secrets check \
  || echo "WARNING: secrets check failed — job secrets will not resolve until fixed"

# ---------------------------------------------------------------------- Nomad
cat > /etc/nomad.d/runtime.hcl <<'EOT'
datacenter = "${datacenter}"
region     = "${nomad_region}"

client {
  node_pool  = "${node_pool}"
  node_class = "${node_class}"

  server_join {
    retry_join = ["provider=aws tag_key=${server_join_tag_key} tag_value=${server_join_tag_value}"]
  }
}
EOT

systemctl enable --now nomad

# -------------------------------------------------------------------- Traefik
%{ if enable_traefik ~}
# Runtime static config (merges over the baked static.env).
umask 077
cat > /etc/traefik/traefik.env <<'EOT'
TRAEFIK_PROVIDERS_FILE_DIRECTORY=/etc/traefik/dynamic
TRAEFIK_PROVIDERS_FILE_WATCH=true
TRAEFIK_CERTIFICATESRESOLVERS_LE_ACME_EMAIL=${traefik_acme_email}
TRAEFIK_CERTIFICATESRESOLVERS_LE_ACME_STORAGE=/etc/traefik/acme.json
%{ if traefik_dashboard_users != "" ~}
TRAEFIK_API_DASHBOARD=true
%{ endif ~}
EOT
%{ if traefik_acme_challenge == "dns" ~}
# DNS-01 via Cloudflare: works with proxied records and needs no inbound
# port 80. The API token is seeded in the cluster vault before apply.
cf_token=$(/opt/nomad/plugins/secrets/secrets fetch "${cloudflare_token_ref}" | jq -r '.result.value // empty')
if [ -z "$cf_token" ]; then
  echo "WARNING: ${cloudflare_token_ref} not found — ACME DNS-01 will fail until it exists and traefik restarts" >&2
fi
cat >> /etc/traefik/traefik.env <<EOT
TRAEFIK_CERTIFICATESRESOLVERS_LE_ACME_DNSCHALLENGE=true
TRAEFIK_CERTIFICATESRESOLVERS_LE_ACME_DNSCHALLENGE_PROVIDER=cloudflare
CF_DNS_API_TOKEN=$cf_token
EOT
%{ else ~}
cat >> /etc/traefik/traefik.env <<'EOT'
TRAEFIK_CERTIFICATESRESOLVERS_LE_ACME_HTTPCHALLENGE=true
TRAEFIK_CERTIFICATESRESOLVERS_LE_ACME_HTTPCHALLENGE_ENTRYPOINT=web
EOT
%{ endif ~}
chmod 0600 /etc/traefik/traefik.env
umask 022

# Routes that need no Nomad ACL token: the Nomad UI is plain reverse
# proxying (the browser authenticates itself to Nomad), and the dashboard
# is Traefik-internal. Only *service discovery* needs a token, below.
install -d /etc/traefik/dynamic
cat > /etc/traefik/dynamic/platform.yml <<'EOT'
http:
  routers:
    nomad-ui:
      rule: Host(`nomad.${fqdn_base}`)
      entryPoints: [websecure]
      service: nomad-ui
      tls:
        certResolver: le
%{ if traefik_dashboard_users != "" ~}
    traefik-dashboard:
      rule: Host(`traefik.${fqdn_base}`)
      entryPoints: [websecure]
      service: api@internal
      middlewares: [dashboard-auth]
      tls:
        certResolver: le
  middlewares:
    dashboard-auth:
      basicAuth:
        users:
          - "${traefik_dashboard_users}"
%{ endif ~}
  services:
    nomad-ui:
      loadBalancer:
        servers:
          - url: http://127.0.0.1:4646
EOT

# Nomad-provider token self-fetch: the ACL playbook stores the token in
# 1Password AFTER the cluster is up; this timer polls for it via the
# secrets plugin binary and hot-enables service discovery when it
# appears. Until then Traefik still serves the routes above.
cat > /usr/local/bin/traefik-nomad-token <<'EOT'
#!/usr/bin/env bash
set -euo pipefail
ENV_FILE=/etc/traefik/nomad-token.env
if grep -qs ENDPOINT_TOKEN "$ENV_FILE"; then
  systemctl disable --now traefik-nomad-token.timer 2>/dev/null || true
  exit 0
fi
out=$(/opt/nomad/plugins/secrets/secrets fetch "${traefik_token_ref}")
tok=$(jq -r '.result.value // empty' <<<"$out")
if [ -z "$tok" ]; then
  echo "traefik token not in 1Password yet: $(jq -r '.error // "unknown"' <<<"$out")" >&2
  exit 1
fi
umask 077
echo "TRAEFIK_PROVIDERS_NOMAD_ENDPOINT_TOKEN=$tok" > "$ENV_FILE"
systemctl restart traefik
systemctl disable --now traefik-nomad-token.timer 2>/dev/null || true
echo "traefik nomad-provider token installed"
EOT
chmod 0755 /usr/local/bin/traefik-nomad-token

cat > /etc/systemd/system/traefik-nomad-token.service <<'EOT'
[Unit]
Description=Fetch Traefik's Nomad ACL token from 1Password
[Service]
Type=oneshot
ExecStart=/usr/local/bin/traefik-nomad-token
EOT

cat > /etc/systemd/system/traefik-nomad-token.timer <<'EOT'
[Unit]
Description=Poll 1Password for Traefik's Nomad ACL token
[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
[Install]
WantedBy=timers.target
EOT

systemctl daemon-reload
systemctl enable --now traefik
systemctl enable --now traefik-nomad-token.timer
%{ endif ~}

echo "user-data: node ready (pool=${node_pool}, dc=${datacenter}, traefik=${enable_traefik})"
