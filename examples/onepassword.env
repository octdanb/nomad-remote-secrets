# Host-level configuration for the onepassword Nomad secret provider.
#
# Install as /etc/nomad-secret-onepassword/config.env (mode 0600, owned by
# the user the Nomad agent runs as — usually root).
#
# Values in this file take precedence over the plugin's process environment.
# That is a security feature: Nomad passes a job's secret env{} block into
# the plugin's environment, so without this file a job author could redirect
# OP_CONNECT_HOST to a server they control and capture the Connect token.
# Always ship this file on production client nodes.

# Where the 1Password Connect server is reachable from this node.
OP_CONNECT_HOST=http://127.0.0.1:8080

# The Connect access token. Prefer OP_CONNECT_TOKEN_FILE so the token itself
# lives in a root-only file and never appears in process listings of this
# config being templated out.
#OP_CONNECT_TOKEN=eyJhbGciOi...
OP_CONNECT_TOKEN_FILE=/etc/nomad-secret-onepassword/token

# How long a fetched secret is served from the on-disk cache without asking
# Connect again. Accepts Go durations ("5m", "90s") or bare seconds ("300").
# 0 disables freshness caching. Default: 5m.
#OP_CACHE_TTL=5m

# If Connect is unreachable, a cached value no older than this is served so
# deploys keep working through short outages. 0 disables the fallback.
# Default: 24h.
#OP_CACHE_MAX_STALE=24h

# Where cached secrets are stored (root-only, 0700/0600, filenames are
# hashes so op:// paths are not exposed).
# Default: /var/cache/nomad-secret-onepassword
#OP_CACHE_DIR=/var/cache/nomad-secret-onepassword

# Timeout for requests to Connect. Nomad kills a fetch at 60s; stay well
# under so the stale-cache fallback still has time to run. Default: 30s.
#OP_REQUEST_TIMEOUT=30s
