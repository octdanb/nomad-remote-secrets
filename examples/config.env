# Host-level configuration for the remote-secrets Nomad secret provider.
#
# Install as /etc/remote-secrets/config.env (mode 0600, owned by the user the
# Nomad agent runs as — usually root). /etc/nomad.d/remote-secrets.env is also
# consulted if the first path is absent.
#
# Values in this file take precedence over the plugin's process environment.
# That is a security feature: Nomad passes a job's secret env{} block into the
# plugin's environment, so without this file a job author could redirect
# OP_CONNECT_HOST (or AWS_ENDPOINT_URL) to a server they control and capture a
# token. Always ship this file on production client nodes.
#
# Configure ANY SUBSET of the backends below — the reference scheme in each
# job (op://, aws-ssm:, aws-sm:) selects which one resolves it, so a single
# node can serve all three at once.

# ===========================================================================
# 1Password  (op://vault/item[/section]/field)  — pick ONE of A or B
# ===========================================================================
# If a service account token is set it wins and Connect settings are ignored.

# Option A (recommended start): a 1Password service account, scoped read-only
# to the vaults your jobs need. No other infrastructure required. Prefer the
# _FILE variant so the token lives in a root-only file.
OP_SERVICE_ACCOUNT_TOKEN_FILE=/etc/remote-secrets/token
#OP_SERVICE_ACCOUNT_TOKEN=ops_eyJ...

# Option B: a self-hosted 1Password Connect server.
#OP_CONNECT_HOST=http://127.0.0.1:8080
#OP_CONNECT_TOKEN_FILE=/etc/remote-secrets/token
#OP_CONNECT_TOKEN=eyJhbGciOi...

# ===========================================================================
# AWS  (aws-ssm:/param/name  and  aws-sm:secret/name)
# ===========================================================================
# Enabled when AWS_REGION (or AWS_ENDPOINT_URL) is set. On EC2/ECS the SDK
# default credential chain picks up the instance role / IRSA automatically.
#AWS_REGION=ap-southeast-2

# Off an instance role (or under Nomad's controlled plugin environment), pin
# static credentials here so the SDK doesn't stall probing instance metadata.
#AWS_ACCESS_KEY_ID=AKIA...
#AWS_SECRET_ACCESS_KEY=...
#AWS_SESSION_TOKEN=...                 # only for temporary credentials
#AWS_PROFILE=default                   # or select a shared-config profile

# Point at a custom endpoint (localstack, a VPC/PrivateLink endpoint).
#AWS_ENDPOINT_URL=http://127.0.0.1:4566

# SSM SecureString values are decrypted by default; set false to opt out.
#AWS_SSM_DECRYPT=true

# ===========================================================================
# Caching, limits, and timeouts (apply to all backends)
# ===========================================================================

# How long a fetched secret is served from the on-disk cache before the
# backend is asked again. Go durations ("5m", "90s") or bare seconds ("300").
# 0 disables freshness caching. Default: 5m.
#OP_CACHE_TTL=5m

# If the backend is unreachable, a cached value no older than this is served
# so deploys survive short outages. 0 disables the fallback. Default: 24h.
#OP_CACHE_MAX_STALE=24h

# Where cached secrets are stored (root-only; filenames are hashes so
# reference paths are not exposed). Default: /var/cache/remote-secrets
#OP_CACHE_DIR=/var/cache/remote-secrets

# Max raw byte length of a file-like secret (1Password documents/attachments,
# AWS SecretBinary). Larger values are rejected, not truncated. 0 disables.
# Default: 1048576 (1 MiB).
#SECRET_MAX_FILE_BYTES=1048576

# Timeout per backend request. Nomad kills a fetch at 60s; stay well under so
# the stale-cache fallback still has time to run. Default: 30s.
#OP_REQUEST_TIMEOUT=30s
